# Database Configuration
DATABASE_URL=postgresql://user:password@db:5432/road_damage_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=road_damage_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Storage Configuration
STORAGE_TYPE=local  # Options: local, s3
LOCAL_STORAGE_PATH=/app/storage
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Roboflow API
ROBOFLOW_API_KEY=Jg5nNY2yVf0uOReHR3C7
ROBOFLOW_MODEL_ID=road-damages-detection/1
ROBOFLOW_API_URL=https://detect.roboflow.com

# Authentication
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Redis & Celery (for background jobs)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=4

# Application Settings
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Limits
MAX_FILE_SIZE_MB=500
ALLOWED_IMAGE_TYPES=image/jpeg,image/png
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo
ALLOWED_CSV_TYPES=text/csv,application/vnd.ms-excel

# Processing Settings
DEFAULT_FRAME_INTERVAL_SECONDS=10
IMAGE_RESIZE_MAX_DIMENSION=1024
JPEG_QUALITY=95
VIDEO_PROCESSING_TIMEOUT_MINUTES=30
